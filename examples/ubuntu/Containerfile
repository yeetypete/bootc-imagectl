ARG UBUNTU_IMAGE=docker.io/library/ubuntu:26.04@sha256:2260313b31c8c011cd2eebe728008efac1b3982be73eb71348ea2648d2c0e09b


FROM ${UBUNTU_IMAGE} AS system-files

COPY system_files/ /system_files/
RUN chmod -R go-w /system_files

FROM ${UBUNTU_IMAGE} AS bootc-builder

ARG BOOTC_VERSION=v1.17.1
ENV DEBIAN_FRONTEND=noninteractive

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install --no-install-recommends -y \
    build-essential \
    ca-certificates \
    cargo \
    git \
    go-md2man \
    libostree-dev \
    libssl-dev \
    libzstd-dev \
    pkg-config \
    rustc

WORKDIR /bootc

RUN git clone --depth 1 --branch "${BOOTC_VERSION}" https://github.com/bootc-dev/bootc.git .

RUN --mount=type=cache,target=/root/.cargo/registry,sharing=locked \
    --mount=type=cache,target=/bootc/target,sharing=locked \
    make bin install DESTDIR=/out \
      CARGO_OPTIONS=--no-default-features


FROM ${UBUNTU_IMAGE} AS image

ENV DEBIAN_FRONTEND=noninteractive

# Keep package installs from generating an initramfs.
ENV INITRD=No

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install --no-install-recommends -y systemd

# Create every user and group with the UID and GID the sysusers lock file fixes
# before any package can allocate a different one.
COPY --from=system-files /system_files/usr/lib/sysusers.d/00-bootc-imagectl.lock.conf /usr/lib/sysusers.d/
RUN systemd-sysusers

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install --no-install-recommends -y \
    binutils \
    btrfs-progs \
    cryptsetup-bin \
    dmsetup \
    dosfstools \
    dracut \
    fdisk \
    libnss-systemd \
    linux-image-generic \
    openssh-server \
    ostree \
    podman \
    skopeo \
    sudo-rs \
    systemd-boot \
    systemd-boot-efi \
    systemd-cryptsetup \
    systemd-homed \
    systemd-repart \
    systemd-sysv \
    systemd-ukify \
    zstd

# A minimal Ubuntu desktop. systemd-homed creates the first user.
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install --no-install-recommends -y \
    fonts-ubuntu \
    gnome-keyring \
    libpam-gnome-keyring \
    network-manager \
    policykit-desktop-privileges \
    ptyxis \
    ubuntu-desktop-minimal \
    ubuntu-wallpapers \
    xdg-desktop-portal-gnome \
    yaru-theme-gnome-shell \
    yaru-theme-gtk \
    yaru-theme-icon

# Bootc links against the installed libostree.
COPY --from=bootc-builder /out/usr/ /usr/
RUN ldconfig

# systemd-homed's first boot wizard creates the first user.
RUN userdel --remove ubuntu

COPY --from=system-files /system_files/ /

RUN systemctl enable systemd-homed-firstboot.service

LABEL containers.bootc=1
CMD ["/sbin/init"]


FROM image AS finalized

# The directory holding bootc-imagectl, and one holding the Secure Boot
# certificate, are passed as build contexts, the key as a secret:
#
#     podman build --build-context bootc-imagectl=target/release \
#       --build-context secureboot=keys --secret id=secureboot_key,src=keys/secureboot.key .
COPY --from=bootc-imagectl bootc-imagectl /usr/libexec/bootc-imagectl
# finalize signs systemd-boot and stages the certificate for enrollment.
# The certificate is bind-mounted so a new key invalidates the cache.
RUN --network=none \
    --mount=type=secret,id=secureboot_key \
    --mount=type=bind,from=secureboot,source=secureboot.crt,target=/run/secureboot.crt \
    /usr/libexec/bootc-imagectl finalize \
      --sysusers-lock /usr/lib/sysusers.d/00-bootc-imagectl.lock.conf \
      --secureboot-private-key /run/secrets/secureboot_key \
      --secureboot-certificate /run/secureboot.crt


# The UKI embeds the kernel and initramfs.
FROM finalized AS rootfs

RUN bootc container split-kernel-and-rootfs --output /kernel && \
    rm -r /kernel

RUN bootc container lint --fatal-warnings


# WORKAROUND: podman < 6.0 (buildah 1.44) leaves bind-mounted stages out of
# cache keys. Building on rootfs keeps a cached UKI from being reused with a
# different rootfs.
FROM rootfs AS uki

# The kernel and initramfs come from finalized, the systemd-stub from rootfs.
# The UKI is signed with the same key as systemd-boot.
RUN --mount=type=bind,from=rootfs,target=/target \
    --mount=type=bind,from=finalized,source=/usr/lib/modules,target=/kernel \
    --mount=type=secret,id=secureboot_key \
    --mount=type=bind,from=secureboot,source=secureboot.crt,target=/run/secureboot.crt \
    kver="$(ls /kernel)" && \
    mkdir /uki && \
    bootc container ukify --rootfs /target --kernel-dir "/kernel/${kver}" \
      -- --stub /target/usr/lib/systemd/boot/efi/linuxx64.efi.stub \
      --signtool systemd-sbsign --no-sign-kernel \
      --secureboot-private-key /run/secrets/secureboot_key \
      --secureboot-certificate /run/secureboot.crt \
      --output "/uki/${kver}.efi"


FROM rootfs

COPY --from=uki /uki/ /boot/EFI/Linux/
