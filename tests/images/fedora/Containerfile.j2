ARG FEDORA_IMAGE=registry.fedoraproject.org/fedora:44@sha256:72de8cab9539c06d525c73867d5b46b4390a7c71e441a7d99506dd47cd4f7b75


FROM ${FEDORA_IMAGE} AS system-files

COPY system_files/ /system_files/
RUN chmod -R go-w /system_files

FROM ${FEDORA_IMAGE} AS image

COPY --from=system-files /system_files/usr/lib/kernel/ /usr/lib/kernel/

RUN --mount=type=cache,target=/var/cache/libdnf5,sharing=locked \
    dnf install -y --setopt=keepcache=True --setopt=install_weak_deps=False systemd

# Create every user and group with the UID and GID the sysusers lock file fixes
# before any package can allocate a different one.
COPY --from=system-files /system_files/usr/lib/sysusers.d/00-bootc-imagectl.lock.conf /usr/lib/sysusers.d/
RUN systemd-sysusers

RUN --mount=type=cache,target=/var/cache/libdnf5,sharing=locked \
    dnf install -y --setopt=keepcache=True --setopt=install_weak_deps=False \
    binutils \
    bootc \
    btrfs-progs \
    cryptsetup \
    dbus \
    dosfstools \
    dracut \
    e2fsprogs \
    kernel \
    NetworkManager \
    openssh-clients \
    openssh-server \
    systemd-boot-unsigned \
    systemd-ukify \
    zstd

# WORKAROUND: bootc 1.17, which accepts composefs-native images without ostree's
# files, is only in updates-testing.
RUN --mount=type=cache,target=/var/cache/libdnf5,sharing=locked \
    dnf upgrade -y --setopt=keepcache=True --enablerepo=updates-testing bootc-1.17.1

{% if not homed %}
# A regular user with a password and a group, for the tests of the user
# records.
RUN echo 'fedora:fedora' | chpasswd && usermod -aG wheel fedora
{% endif %}

COPY --from=system-files /system_files/ /

# Test: the distro's presets disable this unit, so it stays enabled only if
# finalize records it.
RUN systemctl enable systemd-boot-check-no-failures.service
{% if homed %}
RUN systemctl enable systemd-homed-firstboot.service
{% endif %}
{% if transient_etc %}
# A transient /etc requires setting systemd-firstboot's settings in the image.
RUN systemd-firstboot --keymap=us
{% endif %}

LABEL containers.bootc=1
CMD ["/sbin/init"]


FROM image AS finalized

# The xtask passes the directory holding bootc-imagectl as a build context.
COPY --from=bootc-imagectl bootc-imagectl /usr/libexec/bootc-imagectl
{% if secureboot %}
# finalize signs systemd-boot with the Secure Boot key, and stages its
# certificate for systemd-boot to enroll. The secrets are mounted directly in
# /run, since bootc's lint flags the /run/secrets directory podman creates.
RUN --mount=type=secret,id=secureboot_key,target=/run/secureboot.key \
    --mount=type=secret,id=secureboot_cert,target=/run/secureboot.crt \
    /usr/libexec/bootc-imagectl finalize \
      --sysusers-lock /usr/lib/sysusers.d/00-bootc-imagectl.lock.conf \
      --read-only-accounts \
      --secureboot-private-key /run/secureboot.key \
      --secureboot-certificate /run/secureboot.crt
{% else %}
RUN /usr/libexec/bootc-imagectl finalize --sysusers-lock /usr/lib/sysusers.d/00-bootc-imagectl.lock.conf --read-only-accounts{% if transient_etc %} --transient-etc{% endif %}
{% endif %}


# The UKI embeds the kernel and initramfs.
FROM finalized AS rootfs

RUN bootc container split-kernel-and-rootfs --output /kernel && \
    rm -r /kernel

RUN bootc container lint --fatal-warnings


# The xtask passes rootfs rechunked by chunkah as the chunked build context.
# Seal the UKI from chunked so that its composefs digest covers the mtimes
# chunkah rewrites.
FROM chunked AS uki

{% if secureboot %}
# The UKI is signed with the same key as systemd-boot.
{% endif %}
RUN --mount=type=bind,from=chunked,target=/target \
    --mount=type=bind,from=finalized,source=/usr/lib/modules,target=/kernel \
{% if secureboot %}
    --mount=type=secret,id=secureboot_key,target=/run/secureboot.key \
    --mount=type=secret,id=secureboot_cert,target=/run/secureboot.crt \
{% endif %}
    kver="$(basename "$(dirname /kernel/*/vmlinuz)")" && \
    mkdir /uki && \
    bootc container ukify --rootfs /target --kernel-dir "/kernel/${kver}" \
      -- \
{% if secureboot %}
      --signtool systemd-sbsign --no-sign-kernel \
      --secureboot-private-key /run/secureboot.key \
      --secureboot-certificate /run/secureboot.crt \
{% endif %}
      --output "/uki/${kver}.efi"


FROM chunked

COPY --from=uki /uki/ /boot/EFI/Linux/
