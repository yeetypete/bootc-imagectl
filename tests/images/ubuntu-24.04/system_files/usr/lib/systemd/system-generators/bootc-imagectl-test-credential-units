#!/bin/sh
# WORKAROUND: bcvk's mounts and systemd-vmspawn's sshd key arrive as
# systemd.extra-unit.* and systemd.unit-dropin.* credentials, which systemd
# only installs itself from 256 on. Install them like systemd does on 255.
set -eu

out=$1
creds=/run/credentials/@system

for cred in "$creds"/systemd.extra-unit.*; do
    [ -e "$cred" ] || continue
    cp "$cred" "$out/${cred##*/systemd.extra-unit.}"
done
for cred in "$creds"/systemd.unit-dropin.*; do
    [ -e "$cred" ] || continue
    spec=${cred##*/systemd.unit-dropin.}
    mkdir -p "$out/${spec%%"~"*}.d"
    cp "$cred" "$out/${spec%%"~"*}.d/${spec#*"~"}.conf"
done
