ARG ARCH_IMAGE=docker.io/archlinux/archlinux:base-20260906.0.587188@sha256:1eb3314f8f66ab90c8c755acaf9a5502c705b81104cb885ea69f1c74f3a6bb80


FROM ${ARCH_IMAGE} AS system-files

COPY system_files/ /system_files/
RUN chmod -R go-w /system_files

FROM ${ARCH_IMAGE} AS bootc-builder

ARG BOOTC_VERSION=v1.17.1

RUN --mount=type=cache,target=/var/cache/pacman/pkg,sharing=locked \
    pacman-key --init && pacman-key --populate archlinux && \
    pacman -Syu --noconfirm --needed \
    git \
    go-md2man \
    make \
    ostree \
    pkgconf \
    rust

WORKDIR /bootc

RUN git clone --depth 1 --branch "${BOOTC_VERSION}" https://github.com/bootc-dev/bootc.git .

RUN --mount=type=cache,target=/root/.cargo/registry,sharing=locked \
    --mount=type=cache,target=/bootc/target,sharing=locked \
    CARGO_PROFILE_RELEASE_DEBUG=false CARGO_PROFILE_RELEASE_STRIP=true \
    make bin install DESTDIR=/out \
      CARGO_OPTIONS=--no-default-features


FROM ${ARCH_IMAGE} AS image

# Mask dracut's alpm hooks with empty files to prevent them from building an initramfs into
# /boot when the kernel is installed. finalize builds it next to the kernel.
RUN mkdir -p /etc/pacman.d/hooks && \
    touch /etc/pacman.d/hooks/60-dracut-remove.hook /etc/pacman.d/hooks/90-dracut-install.hook

# Create every user and group with the UID and GID the sysusers lock file fixes
# before any package can allocate a different one.
COPY --from=system-files /system_files/usr/lib/sysusers.d/00-bootc-imagectl.lock.conf /usr/lib/sysusers.d/
RUN systemd-sysusers

RUN --mount=type=cache,target=/var/cache/pacman/pkg,sharing=locked \
    pacman-key --init && pacman-key --populate archlinux && \
    pacman -Syu --noconfirm --needed \
    base \
    binutils \
    btrfs-progs \
    dosfstools \
    dracut \
    linux \
    openssh \
    ostree \
    podman \
    sbsigntools \
    skopeo \
    systemd-ukify \
    tpm2-tools \
    zstd

{% if not homed %}
# A regular user with a password and a group, for the tests of the user
# records.
RUN echo 'archie:archie' | chpasswd && usermod -aG wheel archie
{% endif %}

COPY --from=bootc-builder /out/usr/ /usr/

COPY --from=system-files /system_files/ /

# The tests connect over SSH, which Arch's presets disable.
RUN systemctl enable sshd.service
# Test: the distro's presets disable this unit, so it stays enabled only if
# finalize records it.
RUN systemctl enable systemd-boot-check-no-failures.service
{% if homed %}
RUN systemctl enable systemd-homed-firstboot.service
{% endif %}
{% if transient_etc %}
# A transient /etc requires setting systemd-firstboot's settings in the image.
RUN systemd-firstboot --keymap=us --timezone=UTC
{% endif %}

LABEL containers.bootc=1
CMD ["/sbin/init"]


FROM image AS finalized

# The xtask passes the directory holding bootc-imagectl as a build context.
COPY --from=bootc-imagectl bootc-imagectl /usr/libexec/bootc-imagectl
{% if secureboot %}
# The Secure Boot key is passed as a secret, and its certificate as the
# secureboot build context.
{% endif %}
RUN \
{% if secureboot %}
    --mount=type=secret,id=secureboot_key \
    --mount=type=bind,from=secureboot,source=secureboot-certificate.pem,target=/run/secureboot-certificate.pem \
{% endif %}
    /usr/libexec/bootc-imagectl finalize \
      --read-only-accounts \
{% if transient_etc %}
      --transient-etc \
{% endif %}
{% if secureboot %}
      --secureboot-private-key /run/secrets/secureboot_key \
      --secureboot-certificate /run/secureboot-certificate.pem \
{% endif %}
      --sysusers-lock /usr/lib/sysusers.d/00-bootc-imagectl.lock.conf


# The UKI embeds the kernel and initramfs.
FROM finalized AS rootfs

RUN bootc container split-kernel-and-rootfs --output /kernel && \
    rm -r /kernel

# runtime-deps requires chcon, which Arch's coreutils lacks. bootc only runs it
# with SELinux.
RUN bootc container lint --fatal-warnings --skip runtime-deps


# The xtask passes rootfs rechunked by chunkah as the chunked build context.
# Seal the UKI from chunked so that its composefs digest covers the mtimes
# chunkah rewrites.
FROM chunked AS uki

{% if secureboot %}
# The UKI is signed with the same key as systemd-boot. Its expected PCR 11
# values are also signed, so the TPM releases the root's encryption key only
# to UKIs signed with this key, and only in the initrd. systemd 262 also
# requires --sign-initrd-pcrs for its NvPCRs.
{% endif %}
RUN --mount=type=bind,from=chunked,target=/target \
    --mount=type=bind,from=finalized,source=/usr/lib/modules,target=/kernel \
{% if secureboot %}
    --mount=type=secret,id=secureboot_key \
    --mount=type=bind,from=secureboot,source=secureboot-certificate.pem,target=/run/secureboot-certificate.pem \
{% endif %}
    kver="$(basename "$(dirname /kernel/*/vmlinuz)")" && \
    mkdir /uki && \
    bootc container ukify --rootfs /target --kernel-dir "/kernel/${kver}" \
      -- \
{% if secureboot %}
      --signtool sbsign \
      --pcr-banks sha256 \
      --pcr-private-key /run/secrets/secureboot_key \
      --phases enter-initrd \
      --sign-initrd-pcrs \
      --secureboot-private-key /run/secrets/secureboot_key \
      --secureboot-certificate /run/secureboot-certificate.pem \
{% endif %}
      --output "/uki/${kver}.efi"


FROM chunked

COPY --from=uki /uki/ /boot/EFI/Linux/
